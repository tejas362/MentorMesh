# MentorMesh Backend Environment Configuration
# Copy this file to .env for local overrides

ENVIRONMENT=development
DATABASE_URL=sqlite:///./mentormesh.db
JWT_SECRET=mentormesh-insecure-dev-secret-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
